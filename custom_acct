linelog custom_acct {
    # 日志输出路径 (在容器内)
    filename = ${logdir}/device_access.log
    permissions = 0644

    # 兜底通用格式
    format = "[%S] Action: %{Acct-Status-Type} | User: %{User-Name} | MAC: %{Calling-Station-Id} | IP: %{Framed-IP-Address}"

    # 根据不同的计费报文类型选择不同的日志格式
    reference = "accounting.%{%{Acct-Status-Type}:-unknown}"

    accounting {
        # 接入时
        Start = "[%S] CONNECT    | User: %{User-Name} | MAC: %{Calling-Station-Id} | Client_IP: %{Framed-IP-Address} | NAS_IP: %{NAS-IP-Address}"
        
        # 断开时
        Stop  = "[%S] DISCONNECT | User: %{User-Name} | MAC: %{Calling-Station-Id} | Client_IP: %{Framed-IP-Address} | Duration: %{Acct-Session-Time}s"
        
        # 计费更新时 (获取到 IP 后)
        Interim-Update = "[%S] UPDATE     | User: %{User-Name} | MAC: %{Calling-Station-Id} | Client_IP: %{Framed-IP-Address} | Duration: %{Acct-Session-Time}s"
    }
}
